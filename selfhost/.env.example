# =============================================================================
# Paperclip AI self-host — configuration template.  `cp .env.example .env`
# Loaded automatically when you run `docker compose` from this directory.
# =============================================================================

# ── Where clients reach the server ───────────────────────────────────────────
# The URL you type in the browser. Use your LAN IP or a hostname resolvable on
# the LAN. Keep the scheme http:// for plain-HTTP LAN — https:// enables Secure
# cookies and login silently fails without real TLS.
PAPERCLIP_PUBLIC_URL=http://CHANGE-ME:3100

# Extra hostnames/IPs clients use, comma-separated. The PUBLIC_URL host is auto
# allowed; localhost/127.0.0.1/::1 always are. Because the server binds 0.0.0.0
# (not auto-allowed), unlisted Host headers get a 403 — list every name/IP.
PAPERCLIP_ALLOWED_HOSTNAMES=

# Host interface + port to publish. 0.0.0.0 = all interfaces (LAN).
PAPERCLIP_BIND_ADDR=0.0.0.0
PAPERCLIP_PORT=3100

# ── Required secrets — generate each with: openssl rand -hex 32 ───────────────
BETTER_AUTH_SECRET=
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=

# ── Database (external Postgres, never published) ─────────────────────────────
POSTGRES_USER=paperclip
# Strong password: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=paperclip

# ── Signup lockdown (flip to true after claiming the first admin) ─────────────
PAPERCLIP_AUTH_DISABLE_SIGN_UP=false

# ── Logging / resources ──────────────────────────────────────────────────────
PAPERCLIP_LOG_LEVEL=info
PAPERCLIP_MEM_LIMIT=4g
USER_UID=1000
USER_GID=1000

# ── LLM provider keys (optional; add at least one so agents can run) ──────────
#   Claude .......... ANTHROPIC_API_KEY (or subscription login)
#   OpenAI Codex .... OPENAI_API_KEY (also settable per-agent)
#   Gemini .......... GEMINI_API_KEY or GOOGLE_API_KEY
#   OpenCode ........ OPENROUTER_API_KEY (openrouter/ models)
#   xAI Grok ........ XAI_API_KEY
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
GITHUB_TOKEN=
